# 마롱이 설정. 서버에서는 /opt/marong/.env 로 쓰임(처음 설치할 때 이 파일을 복사해 만듦).
# 값은 서버에서만 넣고 깃·채팅·노션·메일에 올리지 않아.
#   넣기:  ssh -t ko-family "sudo -u marong nano /opt/marong/.env"
#   지금 돌던 봇(kakao-bot)의 토큰·키를 그대로 옮기기:  bash deploy/ovh.sh migrate-env  (값을 화면에 보여 주지 않음)
#   확인:  bash deploy/ovh.sh check  ('설정됨'·'정상'으로만 보여 줌)

# 카카오 봇 인증 토큰(카카오 디벨로퍼스 > 앱 > [제품 설정] > [카카오톡 봇] > [봇])
BOT_TOKEN=

# Claude API 키(console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# (선택) 다른 키. 주 키가 실패(한도·크레딧·장애)하면 이 키로 한 번 더
ANTHROPIC_API_KEY_BACKUP=
ANTHROPIC_MODEL=claude-haiku-5-5
# 답장 effort: low·medium·high·xhigh·max (비우면 모델 기본값)
ANTHROPIC_EFFORT=xhigh
# 뒤에서 하는 대화 요약·기억 메모·공유 메모 정리 effort(서버는 xhigh. 줄이 없으면 low)
SUMMARY_EFFORT=xhigh

# Postgres. 서버에서는 그대로 두면 됨(marong 리눅스 계정으로 비밀번호 없이 접속)
DATABASE_URL=postgresql:///marong

# 임베딩(서버 CPU에서 계산. 처음 켤 때 모델 약 1.2GB를 한 번 내려받음). 비우면 '비슷한 예전 대화 찾기'를 끔
EMBED_MODEL=google/embeddinggemma-300m
EMBED_CACHE_DIR=/opt/marong/.cache/fastembed

# 단체방에서는 이 말이 들어간 메시지에만 답함(쉼표로 여러 개, 예: 마롱). 비우면 받은 메시지 모두에 답함
# (카카오는 단체방에서 마롱이를 태그한 메시지만 보내 줌. 태그 없이 한 말은 이 설정과 상관없이 안 옴)
GROUP_TRIGGER=

# 선톡: 1:1 친구에게 하루에 두어 번 마롱이가 먼저 짧은 말 2~3개를 연달아 보내요. on 이면 켜짐(기본 off). 바꾼 뒤 restart
PROACTIVE=off
# PROACTIVE_PER_DAY=2        친구 한 명에게 하루 선톡 수. PROACTIVE_HOURS 를 이만큼 칸으로 나눠 칸마다 한 번(답이 없어도 보냄)
# PROACTIVE_HOURS=12-21      이 시간에만 보냄(한국 시각, 12시부터 21시 전까지)
# PROACTIVE_DAILY_MAX=30     하루 최대 선톡 수(모든 친구 합, 연달아 보낸 말 묶음이 한 번. 카카오 전송 API 는 하루 1,000건)
# 친구마다 다른 횟수·시간은 여기 말고 bash deploy/ovh.sh admin schedule <친구> <하루 횟수> [시작-끝 시] 로 정함

# 구글 시트: 서버가 30분마다 최근 기록을 시트로 보냄(tools/sheet.gs, tools/report.py --sheet).
# 주소는 노트북에서 bash deploy/ovh.sh sheet url 로 넣음(비밀: 아는 사람은 시트에 쓸 수 있음). 켜기: sheet on
# SHEET_URL=
# SHEET_DAYS=30              시트에 보내는 기간(최근 며칠)

# 선택(기본값)
# RECENT_TURNS=10            원문 그대로 다시 넣는 최근 대화 턴
# SUMMARY_TURNS=10           이만큼 쌓이면 요약 한 개
# RECALL_MIN_SIMILARITY=0.4  이보다 덜 비슷한 예전 대화는 넣지 않음
# LLM_TIMEOUT_SECONDS=120
# REPLY_WAIT_SECONDS=2       답하기 전에 친구가 이어서 보내는 말을 기다리는 시간. 그사이(또는 답을 만드는 동안) 더 오면 마지막 말에 한 번에 답함
# LLM_MAX_TOKENS=16000       생각(thinking)까지 포함한 출력 상한
# TIMEZONE=Asia/Seoul
# LOG_LEVEL=INFO
