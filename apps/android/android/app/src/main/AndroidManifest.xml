<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The WebView updates navigator.onLine and fires "online" and "offline" only with this
         permission; the "can't connect" page needs both (SPEC-108, BUG-101). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice calls: the page's getUserMedia, granted at the first call (SPEC-106). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- The "통화 중" foreground service and its notification (SPEC-103). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Marong's own call: the ring screen over the lock screen (docs/app-ring.md SPEC-132, SPEC-133). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- The chat window (D20, docs/app-chat.md SPEC-143): the in-app chat above the call window,
             in the same task, so a call goes on under it. Only the app itself opens it. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".ChatActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- Keeps the call alive with the screen off or another app open (SPEC-103). -->
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Messages and rings from Marong's server through FCM (docs/app-chat.md SPEC-121,
             docs/app-ring.md SPEC-132). Only FCM starts it. -->
        <service
            android:name=".MarongMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The ring screen (SCR-110): only the ring notification opens it. -->
        <activity
            android:name=".RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- 거절 on the ring notification: stops the ring in the app only. -->
        <receiver
            android:name=".RingDeclineReceiver"
            android:exported="false" />

        <!-- FCM addresses this installation by its Firebase installation id, not by a token (SPEC-117, SPEC-121). -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="marong_talk" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_marong" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/marong_accent" />
        <!-- No analytics: the app sends nothing about its use (REQ-118). -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

</manifest>
