<?xml version="1.0" encoding="utf-8"?>
<!-- SCR-110 (docs/app-ring.md SPEC-133): who is calling and two large buttons, on the call page's night colour
     (the theme's window background). The buttons are filled on purpose, as on the call page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="72dp"
    android:paddingEnd="24dp"
    android:paddingBottom="56dp">

    <ImageView
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/splash_face" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ring_caller"
        android:textColor="@color/ring_text"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ring_text"
        android:textColor="@color/ring_text_soft"
        android:textSize="18sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:ignore="ButtonStyle">

        <Button
            android:id="@+id/ring_decline"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/ring_decline_button"
            android:stateListAnimator="@null"
            android:text="@string/ring_decline"
            android:textAllCaps="false"
            android:textColor="@color/ring_decline_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ring_answer"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/ring_answer_button"
            android:stateListAnimator="@null"
            android:text="@string/ring_answer"
            android:textAllCaps="false"
            android:textColor="@color/ring_answer_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
