<?xml version="1.0" encoding="utf-8"?>
<!-- SCR-110 (docs/app-ring.md SPEC-133): who is calling and two large buttons, on the call page's night colour
     (the theme's window background). The buttons are filled on purpose, as on the call page.
     The outer frame takes the status and navigation bars as its padding (fitsSystemWindows replaces a view's own
     padding), so the margins below come on top of the bars and the buttons stay off the screen edges. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_face" />

        <TextView
            android:id="@+id/ring_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ring_caller"
            android:textColor="@color/ring_text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ring_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ring_text"
            android:textColor="@color/ring_text_soft"
            android:textSize="18sp" />

        <!-- SCR-110#hello: a hello call's preview line, up to two lines, broken between words. -->
        <TextView
            android:id="@+id/ring_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineBreakWordStyle="phrase"
            android:maxLines="2"
            android:textColor="@color/ring_text"
            android:textSize="18sp"
            android:visibility="gone"
            tools:targetApi="33" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/ring_decline"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/ring_decline_button"
                android:stateListAnimator="@null"
                android:text="@string/ring_decline"
                android:textAllCaps="false"
                android:textColor="@color/ring_decline_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ring_answer"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/ring_answer_button"
                android:stateListAnimator="@null"
                android:text="@string/ring_answer"
                android:textAllCaps="false"
                android:textColor="@color/ring_answer_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
