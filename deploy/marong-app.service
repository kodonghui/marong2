[Unit]
Description=Marong web and Android app
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=marong
Group=marong
WorkingDirectory=/opt/marong
EnvironmentFile=/etc/marong-app/config
LoadCredential=fcm-service-account.json:/etc/marong-discord/fcm-service-account.json
LoadCredential=google-client.json:/etc/marong-discord/google-client.json
StateDirectory=marong-app
StateDirectoryMode=0700
Environment=MARONG_CHARACTER_DIR=/var/lib/marong-app
Environment=MARONG_CALL_MEMORY=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/marong-app/vendor
ExecStart=/opt/marong/.venv/bin/python /opt/marong-app/run_app.py
Restart=on-failure
RestartSec=15s
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/marong/.cache/fastembed
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
